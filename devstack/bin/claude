#!/usr/bin/env node
// A fake `claude` for local development. It speaks the same stream-json
// protocol the runner uses (initialize, user turn, permission requests,
// interrupt, --resume / --fork-session / --resume-session-at), writes a
// transcript in Claude Code's layout and publishes it to the mock archive.
// It never talks to a model: replies are scripted from the prompt.
import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import readline from 'node:readline'
import { claudeFile, iso, publishClaude, readLines, sleep, uuid, writeLines } from '../lib.mjs'

const argv = process.argv.slice(2)
if (argv.includes('--version')) {
  console.log('2.1.308 (Claude Code, dev stand-in)')
  process.exit(0)
}
const flag = (name) => {
  const i = argv.indexOf(name)
  return i >= 0 ? argv[i + 1] : undefined
}
const resume = flag('--resume')
const fork = argv.includes('--fork-session')
const cutAt = flag('--resume-session-at')
let mode = flag('--permission-mode') || 'bypassPermissions'
const launchMode = mode
const MODEL_IDS = { opus: 'claude-opus-5-5', sonnet: 'claude-sonnet-5-5', haiku: 'claude-haiku-5-5' }
let model = MODEL_IDS[flag('--model')] || flag('--model') || 'claude-opus-5-5'
const effort = flag('--effort') || ''
const cwd = process.cwd()
const speed = Number(process.env.FAKE_SPEED || 1)

const out = (v) => process.stdout.write(JSON.stringify(v) + '\n')

// ---------- transcript ----------
let sid = resume && !fork ? resume : uuid()
let lines = []
if (resume) {
  const src = readLines(claudeFile(resume))
  if (!src.length) {
    out({ type: 'result', subtype: 'error_during_execution', is_error: true, result: `No conversation found with session ID: ${resume}`, session_id: sid })
    process.exit(1)
  }
  lines = src
  if (cutAt) {
    const i = src.findIndex((l) => l.uuid === cutAt)
    if (i < 0) {
      out({ type: 'result', subtype: 'error_during_execution', is_error: true, result: `No message found with message.uuid of: ${cutAt}`, session_id: sid })
      process.exit(1)
    }
    // A fork copies the history up to there. Without --fork-session the session itself goes on from
    // there: like the real CLI, what followed stays in the file as a branch nothing points to any more.
    if (fork) lines = src.slice(0, i + 1)
  }
  lines = lines.map((l) => ({ ...l, sessionId: sid }))
}
const file = claudeFile(sid, lines[0]?.cwd || cwd)
let parent = cutAt && !fork ? cutAt : lines.length ? lines[lines.length - 1].uuid : null
const add = (type, message, extra = {}) => {
  const l = { type, uuid: uuid(), parentUuid: parent, sessionId: sid, timestamp: iso(Date.now()), cwd: lines[0]?.cwd || cwd, isSidechain: false, message, ...extra }
  parent = l.uuid
  lines.push(l)
  writeLines(file, lines)
  return l
}
const publish = () => publishClaude(sid, lines[0]?.cwd || cwd)

// ---------- protocol ----------
const COMMANDS = [
  ['compact', 'Clear conversation history but keep a summary in context', '<optional custom summarization instructions>'],
  ['context', 'Show what is using the context window', ''],
  ['init', 'Initialize a new CLAUDE.md file with codebase documentation', ''],
  ['review', 'Review a pull request', '[PR number]'],
  ['code-review', 'Review the current diff for correctness bugs', '[effort] [target]'],
  ['security-review', 'Complete a security review of the pending changes on the current branch', ''],
  ['simplify', 'Review the changed code for reuse and simplification, then apply the fixes', ''],
  ['usage', 'Show plan usage limits', ''],
  ['recap', 'Summarize what happened in this session so far', ''],
  ['deploy-staging', 'Project command: build and roll out to the staging box', '[service]'],
].map(([name, description, argumentHint]) => ({ name, description, argumentHint }))
const LEVELS = ['low', 'medium', 'high', 'xhigh', 'max']
const MODELS = [
  ['default', 'Default (recommended)', 'Opus 5.5 · Best for everyday, complex tasks', LEVELS],
  ['opus', 'Opus 5.5', 'Best for everyday, complex tasks', LEVELS],
  ['claude-fable-5-2', 'Fable 5.2', 'Most capable for your hardest and longest-running tasks', LEVELS],
  ['sonnet', 'Sonnet 5.5', 'Fast and capable for most coding work', LEVELS],
  ['haiku', 'Haiku 5.5', 'Fastest for quick answers', LEVELS],
  ['claude-haiku-4-5-20251001', 'Haiku 4.5', 'Older, fastest', []],
  ['claude-opus-4-6', 'Opus 4.6', 'Older generation', ['low', 'medium', 'high', 'max']],
].map(([value, displayName, description, levels]) => ({ value, displayName, description, supportsEffort: levels.length > 0, supportedEffortLevels: levels }))

const pending = new Map()
let aborted = false
let abort = () => {}
const wait = (ms) => Promise.race([sleep(ms / speed), new Promise((r) => { abort = r })])

async function ask(tool, input, description, safety) {
  const id = 'perm_' + uuid().slice(0, 8)
  const why = safety ? { decision_reason: safety, decision_reason_type: 'safetyCheck', permission_suggestions: [] }
    : { permission_suggestions: [{ type: 'addRules', rules: [{ toolName: tool }], behavior: 'allow', destination: 'session' }] }
  out({ type: 'control_request', request_id: id, request: { subtype: 'can_use_tool', tool_name: tool, input, description, ...why } })
  return new Promise((res) => pending.set(id, res))
}

// Messages written while a turn is going: like the real CLI, the agent sees them
// after the tool call under way, within the same turn.
let inTurn = false
const steer = []
let heard = []
function hearSteer() {
  while (steer.length) {
    const s = steer.shift()
    add('user', { role: 'user', content: s })
    heard.push(s)
  }
}

let n = 0
const say = (blocks) => {
  const message = { id: 'msg_' + uuid().slice(0, 12), role: 'assistant', model, content: blocks }
  add('assistant', message)
  out({ type: 'assistant', message, parent_tool_use_id: null, session_id: sid })
}
async function tool(name, input, result, { needsOk = false, error = false, ms = 700, id = 'toolu_' + uuid().slice(0, 10) + n++, safety = '' } = {}) {
  say([{ type: 'tool_use', id, name, input }])
  // A safety check asks whatever the mode, as Claude Code's do (a dangerous rm, say).
  if (safety || (needsOk && (mode === 'default' || (mode === 'acceptEdits' && name === 'Bash')))) {
    const ans = await ask(name, input, input.description || '', safety)
    if (ans.behavior !== 'allow') {
      result = ans.message || 'The user denied this action.'
      error = true
    }
  }
  if (aborted) return
  await wait(ms)
  if (aborted) return
  const message = { role: 'user', content: [{ type: 'tool_result', tool_use_id: id, content: result, ...(error ? { is_error: true } : {}) }] }
  add('user', message)
  out({ type: 'user', message, parent_tool_use_id: null, session_id: sid })
  hearSteer()
}

const history = () => lines.filter((l) => l.type === 'user' && typeof l.message?.content === 'string').map((l) => l.message.content)

async function turn(prompt) {
  const t0 = Date.now()
  out({ type: 'system', subtype: 'init', session_id: sid, model, cwd, permissionMode: mode, claude_code_version: '2.1.308', slash_commands: COMMANDS.map((c) => c.name),
    tools: Array(42).fill('t'), skills: Array(27).fill('s'), plugins: [], agents: ['general-purpose', 'Explore'], output_style: 'default' })
  add('user', { role: 'user', content: prompt })
  // The plan allowance, as the real CLI reports it with every turn: it creeps up as the day goes on.
  const now = Date.now(), H = 3600_000
  out({ type: 'rate_limit_event', rate_limit_info: { status: 'allowed', rateLimitType: 'five_hour', resetsAt: Math.ceil(now / (5 * H)) * 5 * H / 1000, unifiedWindows: {
    five_hour: { utilization: Math.round((now % (5 * H)) / (5 * H) * 80) / 100, resetsAt: Math.ceil(now / (5 * H)) * 5 * H / 1000 },
    seven_day: { utilization: Math.round((now % (168 * H)) / (168 * H) * 70) / 100, resetsAt: Math.ceil(now / (168 * H)) * 168 * H / 1000 },
  } } })
  inTurn = true
  heard = []
  const done = (result, is_error = false) => {
    if (heard.length && !is_error) {
      const t = '（中途收到你的消息，已经照做：' + heard.map((h) => '“' + h.slice(0, 40) + '”').join('、') + '）'
      say([{ type: 'text', text: t }])
      result = (result ? result + '\n\n' : '') + t
    }
    inTurn = false
    if (steer.length) {
      // Came after the last tool call: the CLI starts a turn of its own for it.
      const next = steer.splice(0).join('\n\n')
      setTimeout(() => { running = (running || Promise.resolve()).then(() => { aborted = false; return turn(next) }) }, 50)
    }
    publish()
    out({ type: 'result', subtype: is_error ? 'error_during_execution' : 'success', is_error, result, duration_ms: Date.now() - t0, total_cost_usd: 0.0421, num_turns: 3, session_id: sid,
      modelUsage: { [model]: { inputTokens: 12, outputTokens: 1840, cacheReadInputTokens: 61400, cacheCreationInputTokens: 5200, costUSD: 0.0421, contextWindow: 1000000 } } })
  }
  await wait(500)
  if (aborted) return done('')
  const past = history().slice(0, -1)

  if (/^\/compact/.test(prompt)) {
    out({ type: 'system', subtype: 'compact_boundary', session_id: sid })
    lines.push({ type: 'system', subtype: 'compact_boundary', uuid: uuid(), parentUuid: parent, sessionId: sid, timestamp: iso(Date.now()), cwd })
    say([{ type: 'text', text: 'Compacted. The summary keeps the open questions and the files touched so far.' }])
    return done('ok')
  }
  if (/报错|fail/i.test(prompt)) return done('API Error: 529 overloaded (simulated)', true)
  if (/问我|ask me/i.test(prompt)) {
    // A question: one with a few options, several options at once ("多选", "multi"), or two questions ("两个", "two").
    const multi = /多选|multi/i.test(prompt)
    const questions = [{ question: '部署到哪个环境？', header: '环境', multiSelect: multi, options: [{ label: '测试环境', description: '先在这里跑一遍' }, { label: '预发环境', description: '和线上同配置' }, { label: '线上', description: '直接发布' }] }]
    if (/两个|two/i.test(prompt)) questions.push({ question: '什么时候开始？', header: '时间', multiSelect: false, options: [{ label: '现在' }, { label: '今晚' }] })
    const id = 'toolu_' + uuid().slice(0, 10) + n++
    say([{ type: 'tool_use', id, name: 'AskUserQuestion', input: { questions } }])
    const rid = 'perm_' + uuid().slice(0, 8)
    out({ type: 'control_request', request_id: rid, request: { subtype: 'can_use_tool', tool_name: 'AskUserQuestion', input: { questions } } })
    const ans = await new Promise((res) => pending.set(rid, res))
    if (aborted) return
    const got = ans.behavior === 'allow' ? questions.map((q) => `${q.header}：${ans.updatedInput?.answers?.[q.question] ?? '（没有回答）'}`).join('；') : '你跳过了这个问题'
    const text = `收到你的回答。${got}。`
    say([{ type: 'text', text }])
    return done(text)
  }
  if (/危险|dangerous/i.test(prompt)) {
    await tool('Bash', { command: 'rm -rf "$(cat /tmp/old-build.dir)"', description: 'Remove the old build folder' }, '(Bash completed with no output)',
      { safety: 'Dangerous rm operation on statically-unresolvable target: command substitution output' })
    const text = '旧的构建目录处理好了。'
    say([{ type: 'text', text }])
    return done(text)
  }
  if (/慢慢|slowly|steps/i.test(prompt)) {
    // Several tool calls in a row, so a message can be sent in between.
    for (const k of [1, 2, 3, 4]) await tool('Bash', { command: `sleep 2; echo step ${k}`, description: `Step ${k}` }, `step ${k}`, { ms: 2500 })
    if (aborted) return done('')
    const text = '四步都做完了。'
    say([{ type: 'text', text }])
    return done(text)
  }
  if (/后台|background/i.test(prompt)) {
    const tu = 'toolu_' + uuid().slice(0, 10) + n++
    const dev = startTask('npm run dev', 'local_bash', 40000, tu)
    await tool('Bash', { command: 'npm run dev', description: 'Start the dev server', run_in_background: true },
      `Command running in background with ID: ${dev}. Output is being written to: ${bg.get(dev).file}. You will be notified when it completes.`, { ms: 400, id: tu })
    startTask('Watch the build log for errors', 'monitor', 25000)
    const text = '开发服务器已经在后台启动，另外挂了一个监视在看构建日志。它们结束时我会再说一声。'
    say([{ type: 'text', text }])
    return done(text)
  }
  if (/\[Attached files/.test(prompt)) {
    // Attachments: say which of the named files are there, and whether their folder was opened with --add-dir.
    const allowed = argv.flatMap((x, i) => (x === '--add-dir' ? [argv[i + 1]] : []))
    const files = prompt.split('\n').filter((l) => l.startsWith('- /')).map((l) => l.slice(2).trim())
    await wait(500)
    const text = '看到附件：\n\n' + files.map((f) => {
      let size = -1
      try { size = fs.statSync(f).size } catch { /* missing */ }
      return `- \`${path.basename(f)}\`：${size < 0 ? '文件不存在' : size + ' 字节'}，${allowed.includes(path.dirname(f)) ? '目录已放行' : '目录没有放行'}`
    }).join('\n')
    say([{ type: 'text', text }])
    return done(text)
  }
  if (/回顾|recap|history/i.test(prompt)) {
    const text = past.length ? '到目前为止，这个会话里你发过这些消息：\n\n' + past.map((p, i) => `${i + 1}. ${p.slice(0, 80)}`).join('\n') : '这是这个会话的第一条消息。'
    say([{ type: 'text', text }])
    return done(text)
  }
  if (/^(hi|hello|你好|在吗)\b/i.test(prompt) || prompt.length < 12) {
    await wait(600)
    const text = `收到：“${prompt}”。（这是开发环境里的假 Claude，模型 \`${model}\`${effort ? '，思考强度 `' + effort + '`' : ''}，权限模式 \`${mode}\`，此前共 ${past.length} 条用户消息。）`
    say([{ type: 'text', text }])
    return done(text)
  }

  say([{ type: 'thinking', thinking: `The user asks: ${prompt.slice(0, 120)}\nI should look at the repository layout first, then make the smallest change that works, then run the tests.` }])
  await wait(700)
  if (aborted) return done('')
  say([{ type: 'text', text: '我先看一下项目结构，再动手。' }])
  await tool('Bash', { command: 'git status --short && ls', description: 'Check the working tree' }, ' M web/src/App.tsx\n?? notes.md\nMakefile\nREADME.md\ncmd\nweb', { needsOk: true })
  if (aborted) return done('')
  await tool('Read', { file_path: cwd + '/web/src/App.tsx' }, "import { useState } from 'react'\n\nexport function App() {\n  const [n, setN] = useState(0)\n  return <button onClick={() => setN(n + 1)}>{n}</button>\n}\n")
  if (aborted) return done('')
  await tool('Grep', { pattern: 'useState', path: 'web/src' }, 'web/src/App.tsx:1\nweb/src/Sidebar.tsx:3')
  if (aborted) return done('')
  say([{ type: 'text', text: '找到了入口。计数器没有重置的办法，我加一个。' }])
  await tool('Edit', { file_path: cwd + '/web/src/App.tsx', old_string: '  return <button onClick={() => setN(n + 1)}>{n}</button>', new_string: '  return (\n    <>\n      <button onClick={() => setN(n + 1)}>{n}</button>\n      <button onClick={() => setN(0)}>reset</button>\n    </>\n  )' }, 'The file has been updated.', { needsOk: true })
  if (aborted) return done('')
  await tool('TodoWrite', { todos: [{ content: '看项目结构', status: 'completed' }, { content: '加重置按钮', status: 'completed' }, { content: '跑类型检查', status: 'in_progress' }] }, 'Todos updated')
  if (aborted) return done('')
  await tool('Bash', { command: 'npx tsc --noEmit', description: 'Type-check' }, /类型错误/.test(prompt) ? "web/src/App.tsx(7,9): error TS2322: Type 'string' is not assignable to type 'number'." : '', { needsOk: true, error: /类型错误/.test(prompt), ms: 1400 })
  if (aborted) return done('')
  const text = [
    '改好了。',
    '',
    '## 做了什么',
    '',
    '- 在 `web/src/App.tsx` 里加了一个 **reset** 按钮',
    '- 类型检查通过',
    '',
    '```tsx',
    '<button onClick={() => setN(0)}>reset</button>',
    '```',
    '',
    '| 文件 | 变化 |',
    '|---|---|',
    '| `web/src/App.tsx` | +5 −1 |',
    '',
    `> 这是开发环境里的假 Claude（模型 \`${model}\`${effort ? '，思考强度 `' + effort + '`' : ''}）。此前这个会话里有 ${past.length} 条用户消息。`,
  ].join('\n')
  say([{ type: 'text', text }])
  done(text)
}

// ---------- background tasks ----------
// A prompt that asks for something "in the background" starts one that outlives the turn,
// as the real CLI does: the process stays up until it ends, then tells the agent.
const bg = new Map()
const bgList = () => out({ type: 'system', subtype: 'background_tasks_changed', session_id: sid, tasks: [...bg.values()].map((x) => ({ task_id: x.id, task_type: x.type, description: x.description })) })
let bgIdle = () => {}
function startTask(description, type, ms, toolUseId) {
  const id = 'b' + uuid().slice(0, 8)
  // The output goes to a file, a line a second, as a dev server or a build would.
  const dir = path.join(os.tmpdir(), 'atrium-fake-claude', sid, 'tasks')
  fs.mkdirSync(dir, { recursive: true })
  const file = path.join(dir, id + '.output')
  fs.writeFileSync(file, `$ ${description}\n`)
  let k = 0
  const tick = setInterval(() => fs.appendFileSync(file, type === 'monitor' ? `[watch] ${new Date().toISOString().slice(11, 19)} build ok (${++k})\n` : `ready in ${120 + (++k) * 7} ms · GET /api/health 200\n`), 1000 / speed)
  const x = { id, type, description, file, tick, timer: setTimeout(() => endTask(id, 'completed'), ms / speed) }
  bg.set(id, x)
  bgList()
  out({ type: 'system', subtype: 'task_started', session_id: sid, task_id: id, description, is_backgrounded: true, task_type: type, ...(toolUseId ? { tool_use_id: toolUseId } : {}) })
  return id
}
function endTask(id, status) {
  const x = bg.get(id)
  if (!x) return
  clearTimeout(x.timer)
  clearInterval(x.tick)
  fs.appendFileSync(x.file, status === 'killed' ? '[stopped]\n' : '[exited with code 0]\n')
  bg.delete(id)
  out({ type: 'system', subtype: 'task_updated', session_id: sid, task_id: id, patch: { status, end_time: Date.now() } })
  out({ type: 'system', subtype: 'task_notification', session_id: sid, task_id: id, status, output_file: x.file, summary: `Background command "${x.description}" ${status}` })
  bgList()
  if (bg.size === 0) {
    const text = status === 'killed' ? '后台任务被停掉了。' : `后台任务“${x.description}”跑完了，没有别的在等。`
    out({ type: 'system', subtype: 'init', session_id: sid, model, cwd, permissionMode: mode, claude_code_version: '2.1.308', tools: [], skills: [] })
    say([{ type: 'text', text }])
    out({ type: 'result', subtype: 'success', is_error: false, result: text, duration_ms: 400, total_cost_usd: 0.003, num_turns: 1, session_id: sid })
    bgIdle()
  }
}

const rl = readline.createInterface({ input: process.stdin })
let running = null
rl.on('line', (line) => {
  let m
  try {
    m = JSON.parse(line)
  } catch {
    return
  }
  if (m.type === 'control_request' && m.request?.subtype === 'initialize') {
    out({ type: 'control_response', response: { subtype: 'success', request_id: m.request_id, response: { commands: COMMANDS, models: MODELS, claude_code_version: '2.1.308' } } })
  } else if (m.type === 'control_request' && m.request?.subtype === 'get_context_usage') {
    // Grows with the conversation, like the real thing.
    const msgs = 4200 + lines.length * 2600
    const max = 1000000, fixed = 10700 + 21100 + 6000 + 80
    const cat = (id, name, tokens, kind = 'used') => ({ id, name, tokens, kind, color: 'x' })
    out({ type: 'control_response', response: { subtype: 'success', request_id: m.request_id, response: {
      categories: [cat('system_prompt', 'System prompt', 10700), cat('system_tools', 'System tools', 21100), cat('system_tools_deferred', 'System tools (deferred)', 25400, 'deferred'),
        cat('memory_files', 'Memory files', 80), cat('skills', 'Skills', 6000), cat('messages', 'Messages', msgs), cat('autocompact_buffer', 'Autocompact buffer', 33000, 'buffer'),
        cat('free_space', 'Free space', max - fixed - msgs - 33000, 'free')],
      totalTokens: fixed + msgs, maxTokens: max, percentage: Math.round((fixed + msgs) * 100 / max), model, isAutoCompactEnabled: true, autoCompactThreshold: 967000,
      memoryFiles: [{ path: cwd + '/CLAUDE.md', type: 'Project', tokens: 80 }], skills: { totalSkills: 27, includedSkills: 27, tokens: 6000 },
      mcpTools: [{ name: 'mcp__docs__read', serverName: 'docs', tokens: 240, isLoaded: false }, { name: 'mcp__docs__write', serverName: 'docs', tokens: 310, isLoaded: true }],
    } } })
  } else if (m.type === 'control_request' && m.request?.subtype === 'mcp_status') {
    out({ type: 'control_response', response: { subtype: 'success', request_id: m.request_id, response: { mcpServers: [{ name: 'docs', status: 'connected', scope: 'user' }, { name: 'tracker', status: 'needs-auth', scope: 'project' }] } } })
  } else if (m.type === 'control_request' && m.request?.subtype === 'get_settings') {
    out({ type: 'control_response', response: { subtype: 'success', request_id: m.request_id, response: { effective: {}, applied: { model, effort: effort || 'medium' } } } })
  } else if (m.type === 'control_request' && m.request?.subtype === 'stop_task') {
    out({ type: 'control_response', response: { subtype: 'success', request_id: m.request_id } })
    endTask(m.request.task_id, 'killed')
  } else if (m.type === 'control_request' && m.request?.subtype === 'interrupt') {
    aborted = true
    abort()
    for (const res of pending.values()) res({ behavior: 'deny', message: 'interrupted' })
    out({ type: 'control_response', response: { subtype: 'success', request_id: m.request_id } })
  } else if (m.type === 'control_response') {
    const res = pending.get(m.response?.request_id)
    pending.delete(m.response?.request_id)
    if (res) res(m.response.response || { behavior: 'deny' })
  } else if (m.type === 'control_request' && m.request?.subtype === 'set_permission_mode') {
    // Like the real CLI: it will not start skipping permissions half-way.
    if (m.request.mode === 'bypassPermissions' && launchMode !== 'bypassPermissions') {
      out({ type: 'control_response', response: { subtype: 'error', request_id: m.request_id, error: 'Cannot set permission mode to bypassPermissions because the session was not launched with it' } })
    } else {
      mode = m.request.mode
      out({ type: 'control_response', response: { subtype: 'success', request_id: m.request_id, response: { mode } } })
    }
  } else if (m.type === 'control_request' && m.request?.subtype === 'set_model') {
    model = MODEL_IDS[m.request.model] || (m.request.model === 'default' ? 'claude-opus-5-5' : m.request.model)
    out({ type: 'control_response', response: { subtype: 'success', request_id: m.request_id, response: { model } } })
  } else if (m.type === 'user') {
    const c = m.message?.content
    const prompt = typeof c === 'string' ? c : (c || []).map((b) => b.text || '').join('')
    if (inTurn) {
      steer.push(prompt) // seen after the tool call under way
      return
    }
    running = (running || Promise.resolve()).then(() => { aborted = false; return turn(prompt) }).catch((e) => {
      out({ type: 'result', subtype: 'error_during_execution', is_error: true, result: String(e), session_id: sid })
    })
  }
})
rl.on('close', async () => {
  if (running) await running
  if (bg.size) await new Promise((r) => { bgIdle = r })
  process.exit(0)
})

#!/usr/bin/env node
// A fake `codex` for local development: `codex exec [resume|fork] --json … -- [id] prompt`.
// Emits the same JSON events as the real CLI and publishes to the mock archive.
import fs from 'node:fs'
import path from 'node:path'
import { CODEX_HOME, MACHINE, iso, loadSession, saveSession, sleep, uuid } from '../lib.mjs'

const argv = process.argv.slice(2)
if (argv.includes('--version')) {
  console.log('codex-cli 0.164.0 (dev stand-in)')
  process.exit(0)
}
if (argv[0] === 'debug' && argv[1] === 'models') {
  const levels = (list) => list.map((effort) => ({ effort, description: '' }))
  const all = ['low', 'medium', 'high', 'xhigh', 'max']
  console.log(JSON.stringify({
    models: [
      { slug: 'gpt-6.1-sol', display_name: 'GPT-6.1-Sol', description: 'Latest workhorse model for coding and everyday work.', visibility: 'list', default_reasoning_level: 'low', supported_reasoning_levels: levels([...all, 'ultra']) },
      { slug: 'gpt-6-astra', display_name: 'GPT-6-Astra', description: 'Frontier intelligence for the most demanding work.', visibility: 'list', default_reasoning_level: 'medium', supported_reasoning_levels: levels([...all, 'ultra']) },
      { slug: 'gpt-6-luna', display_name: 'GPT-6-Luna', description: 'Fast and affordable model for easier tasks.', visibility: 'list', default_reasoning_level: 'medium', supported_reasoning_levels: levels(all) },
      { slug: 'codex-auto-review', display_name: 'Codex Auto Review', description: 'Internal.', visibility: 'hide', default_reasoning_level: 'medium', supported_reasoning_levels: levels(all) },
    ],
  }))
  process.exit(0)
}
const effortArg = argv.find((a) => a.startsWith('model_reasoning_effort='))
const modelIdx = argv.indexOf('-m')
const sub = argv[1] === 'resume' || argv[1] === 'fork' ? argv[1] : ''
const rest = argv.slice(argv.indexOf('--') + 1)
const srcId = sub ? rest[0] : ''
const prompt = sub ? rest[1] : rest[0]
const ci = argv.indexOf('-C')
const out = (v) => process.stdout.write(JSON.stringify(v) + '\n')
const home = process.env.CODEX_HOME || CODEX_HOME

const src = srcId ? loadSession('codex:' + srcId) : null
if (sub && !src) {
  out({ type: 'error', message: `no rollout found for ${srcId}` })
  process.exit(1)
}
const id = sub === 'resume' ? srcId : uuid()
const cwd = src?.cwd || (ci >= 0 ? argv[ci + 1] : process.cwd())
const messages = src ? [...src.messages] : []
const push = (role, content, extra = {}) => messages.push({ ordinal: messages.length, role, content, timestamp: iso(Date.now()), ...extra })

out({ type: 'thread.started', thread_id: id })
out({ type: 'turn.started' })
push('user', prompt)
await sleep(500)
out({ type: 'item.completed', item: { id: 'item_0', type: 'reasoning', text: '**Looking around**\nCheck the tree before answering.' } })
out({ type: 'item.started', item: { id: 'item_1', type: 'command_execution', command: "bash -lc 'ls -la'", aggregated_output: '', status: 'in_progress' } })
await sleep(900)
const listing = 'total 24\n-rw-r--r--  1 dev  staff  1125 Makefile\n-rw-r--r--  1 dev  staff  5429 README.md\ndrwxr-xr-x  4 dev  staff   128 cmd\n'
out({ type: 'item.completed', item: { id: 'item_1', type: 'command_execution', command: "bash -lc 'ls -la'", aggregated_output: listing, exit_code: 0, status: 'completed' } })
await sleep(600)
const users = messages.filter((m) => m.role === 'user').length
const text = `Done. (Fake Codex in the dev environment${modelIdx >= 0 ? ', model ' + argv[modelIdx + 1] : ''}${effortArg ? ', ' + effortArg.replace(/"/g, '') : ''}; this thread now has ${users} user message${users > 1 ? 's' : ''}${sub === 'fork' ? ', forked from ' + srcId.slice(0, 8) : ''}.)\n\n- listed the working tree\n- nothing needed changing`
out({ type: 'item.completed', item: { id: 'item_2', type: 'agent_message', text } })
push('assistant', text, {
  thinking_text: 'Looking around', has_tool_use: true, model: 'gpt-5.5-codex',
  tool_calls: [{ tool_name: 'exec_command', category: 'Bash', tool_use_id: 'call_' + uuid().slice(0, 8), input_json: JSON.stringify({ cmd: 'ls -la' }), result_content: listing, result_content_length: listing.length }],
})
const us = messages.filter((m) => m.role === 'user')
saveSession({
  id: 'codex:' + id, source_session_id: id, machine: MACHINE, agent: 'codex', entrypoint: 'exec', cwd,
  first_message: us[0].content, display_name: sub === 'fork' ? '' : src?.display_name || '', started_at: messages[0].timestamp,
  ended_at: messages[messages.length - 1].timestamp, message_count: messages.length, user_message_count: us.length, messages,
})
const d = new Date()
const dir = path.join(home, 'sessions', String(d.getFullYear()), String(d.getMonth() + 1).padStart(2, '0'), String(d.getDate()).padStart(2, '0'))
fs.mkdirSync(dir, { recursive: true })
fs.appendFileSync(path.join(dir, `rollout-${id}.jsonl`), JSON.stringify({ type: 'session_meta', payload: { id, cwd } }) + '\n')
out({ type: 'turn.completed', usage: { input_tokens: 1200, output_tokens: 80 } })

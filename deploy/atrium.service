[Unit]
Description=atrium: one page for all coding-agent sessions (loopback only)
After=network.target agentsview.service

[Service]
User=atrium
Group=atrium
ExecStart=/usr/local/bin/atrium serve --config /srv/atrium/config.json
Restart=always
RestartSec=3
MemoryHigh=150M
MemoryMax=250M
# Loopback only: browsers and machines reach it through SSH tunnels (later: a reverse proxy).
IPAddressDeny=any
IPAddressAllow=localhost
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/srv/atrium
LockPersonality=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
